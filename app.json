{
  "expo": {
    "name": "FamCare",
    "slug": "FamCare",
    "version": "1.0.0",
    "scheme": "famcare",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.famcare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#1f6feb"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FamCare uses your photos to attach a picture of a medication strip or prescription.",
          "cameraPermission": "FamCare uses the camera to capture a photo of a medication strip or prescription."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df1a3ee3-3f40-4487-829a-d3620419cd14"
      }
    },
    "owner": "sprk006"
  }
}
